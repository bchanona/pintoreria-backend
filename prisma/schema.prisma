generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement()) 
  email String @unique
  fullName String
  password String
  role Role @default(VENDEDOR)
  createdAt DateTime @default(now())
  isActive Boolean @default(true) 
}

enum Role {
  ADMIN
  VENDEDOR
  ALMACENERO
}
